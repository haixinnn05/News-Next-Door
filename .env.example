# Copy to .env (never commit real values). Everything is optional — without keys the app runs in a
# clearly-labelled fallback mode: blank manual drafts (no Grok), no audio (no ElevenLabs), and a
# SIMULATED phone at /phone (no Photon).

# ---- App
PORT=8790
# Public URL residents open from iMessage links (your tunnel / host). Dev default is the Vite server.
PUBLIC_BASE_URL=http://localhost:5190
# Password for the team console at /admin
ADMIN_TOKEN=before-the-vote-team
# Show the three fictional SAMPLE proposals (labelled everywhere). Set false for real-data-only.
SHOW_SAMPLE_DATA=true
REMINDER_LEAD_HOURS=24
FOLLOW_CODE_TTL_MINUTES=30
DATA_DIR=./data

# ---- Grok (xAI): document extraction + card translation
XAI_API_KEY=
GROK_MODEL=grok-4.7

# ---- ElevenLabs: English TTS + Chinese dubbing
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_DUB_TARGET=zh

# ---- Photon (Spectrum, hosted iMessage). spectrum-ts is pinned to 12.10.1.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# The iMessage address residents text (E.164 phone like +19295550123, or an email)
PHOTON_LINE_ADDRESS=
