# Copy to .env (never commit real values). Everything is optional — without keys the app runs in a
# clearly-labelled fallback mode: blank manual drafts (no Grok), no audio (no ElevenLabs), and a
# SIMULATED phone at /phone (no Photon).

# ---- App
PORT=8790
# Public URL residents open from iMessage links (your tunnel / host). Dev default is the Vite server.
PUBLIC_BASE_URL=http://localhost:5190
# Password for the team console at /admin — used only until Google sign-in is configured below
ADMIN_TOKEN=before-the-vote-team

# ---- Sign-in (Better Auth). Residents can always sign in with email/password.
# Setting both Google keys adds "Continue with Google" for residents AND switches the team console
# from ADMIN_TOKEN to Google sign-in limited to ADMIN_EMAILS.
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: <PUBLIC_BASE_URL>/api/auth/callback/google
#   dev: http://localhost:5190/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google emails allowed into the team console
ADMIN_EMAILS=
# Signs session cookies. Generate with: openssl rand -base64 32
# Required in production; in development one is generated and kept in DATA_DIR/auth-secret if unset.
BETTER_AUTH_SECRET=
# Show the three fictional SAMPLE proposals (labelled everywhere). Set false for real-data-only.
SHOW_SAMPLE_DATA=true
REMINDER_LEAD_HOURS=24
FOLLOW_CODE_TTL_MINUTES=30
DATA_DIR=./data

# ---- Grok (xAI): document extraction + card translation
XAI_API_KEY=
GROK_MODEL=grok-4.7

# ---- ElevenLabs: English TTS + Chinese dubbing
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_DUB_TARGET=zh

# ---- Photon (Spectrum, hosted iMessage). spectrum-ts is pinned to 12.10.1.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# The iMessage address residents text (E.164 phone like +19295550123, or an email)
PHOTON_LINE_ADDRESS=
