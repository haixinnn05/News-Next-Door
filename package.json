{
  "name": "before-the-vote",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "News Next Door: plain-language, multilingual, source-backed explanations of Queens CB2 proposals with iMessage updates.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch server/main.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/main.ts",
    "test": "tsx --test server/*.test.ts",
    "seed:reset": "tsx server/scripts/resetDb.ts",
    "smoke:grok": "tsx server/scripts/smokeGrok.ts",
    "smoke:elevenlabs": "tsx server/scripts/smokeElevenLabs.ts",
    "smoke:photon": "tsx server/scripts/smokePhoton.ts",
    "smoke:photon-send": "tsx server/scripts/sendPhoton.ts"
  },
  "engines": {
    "node": ">=23.4"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "better-auth": "^1.7.6",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.4",
    "hono": "^4.13.9",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "spectrum-ts": "12.10.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.1"
  }
}
